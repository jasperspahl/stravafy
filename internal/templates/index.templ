package templates

import (
	"fmt"
	"stravafy/internal/manager/config"
)

templ Index() {
	<!DOCTYPE html>
	<html>
		@head()
		<body>
			<section class="hero" data-theme="dark">
				@nav(false)
				<header class="container">
					<hgroup class="container">
						<h1>Stravafy</h1>
						<p>Match your Spotify History to Strava</p>
					</hgroup>
				</header>
			</section>
			<section class="container">
				<article>
					<header class="pico-background-red-500">!!! IMPORTANT !!!</header>
					<p>Stravafy is still very much in development! It is not yet ready for public use. Please check back later. Stravafy currently saves your complete Spotify listening history to a database. Feel free to checkout the github repo to fully understand what happens.</p>
					<a href="https://github.com/jasperspahl/stravafy">Github: jasperspahl/stravafy</a>
				</article>
				<h1>How it works</h1>
				<p>Stravafy is a web application that connects your Spotify and Strava accounts.</p>
				<p>After you log in with your Strava and Spotify accounts, Stravafy will save your current Spotify playing state to it's database.</p>
				<p>When ever you upload a new activity to Strava, Stravafy will check if you were listening to music and add the playlist, playlist author and a link to the playlist you were listening to, to your activity's description</p>
				<p>This will look something like this:</p>
				<pre><code>Playlist: Corrupted Blood<br/>By: HandOfBlood<br/>https://open.spotify.com/playlist/6WlSmKm4leMtyyhqqaDKAb</code></pre>
			</section>
		</body>
	</html>
}

templ ConfigCard(name string, example string, variables map[string]string, config config.Config) {
	<article>
		<header>
			{ name }
			<input
				name="enabled"
				type="checkbox"
				role="switch"
				if config.Enabled {
					checked
				}
			/>
		</header>
		<form>
			<label for="template">
				<details>
					<summary>Template</summary>
					<p>The Templates use golang's text templating.</p>
					<p>Example:</p>
					<pre><code>{ example }</code></pre>
					<p>You have the following variables available:</p>
					<dl>
						for key, value := range variables {
							<dt><b>{ key }</b></dt>
							<dd>{ value }</dd>
						}
					</dl>
				</details>
			</label>
			<textarea
				id="template"
				name="podcast-template"
				cols="30"
				rows="5"
				if !config.Enabled {
					disabled
				}
			>{ config.Template }</textarea>
		</form>
		<footer><pre><code>{ config.Preview }</code></pre></footer>
	</article>
}

type IndexAuthenticatedProps struct {
	StravaID         int64
	FirstName        string
	LastName         string
	StravaProfile    string
	SpotifyConnected bool
	SpotifyUserName  string
	SpotifyID        string
}

templ IndexAuthenticated(props IndexAuthenticatedProps, podcastConfig, playlistConfig config.Config) {
	@layout(true) {
		<main class="container">
			<h1>Stravafy Overview</h1>
			<article>
				<div class="flex">
					<div><img src={ props.StravaProfile } width="64" height="64" alt="" style="border-radius: 50%"/></div>
					<div>
						<p>
							Welcome, <strong>{ props.FirstName }</strong>
							<br/>
							<a href={ templ.SafeURL(fmt.Sprintf("https://www.strava.com/athletes/%d", props.StravaID)) }>Your Strava</a>
						</p>
						if props.SpotifyConnected {
							<p>
								Logged in to Spotify as <strong>{ props.SpotifyUserName }</strong>
								<br/>
								<a href={ templ.SafeURL(fmt.Sprintf("https://open.spotify.com/user/%s", props.SpotifyID)) }>Your Spotify</a>
							</p>
						} else {
							<p><a href="/auth/login/spotify" role="button">Login to Spotify</a></p>
						}
					</div>
				</div>
			</article>
			<section>
				<hgroup>
					<h2>Configuration</h2>
					<p>
						Configure the templates that get used when precessing you activities
					</p>
				</hgroup>
				@ConfigCard("Podcast", config.DefaultConfig[config.Podcast].Template, config.PodcastVariables, podcastConfig)
				@ConfigCard("Playlist", config.DefaultConfig[config.Playlist].Template, map[string]string{}, playlistConfig)
			</section>
		</main>
	}
}
